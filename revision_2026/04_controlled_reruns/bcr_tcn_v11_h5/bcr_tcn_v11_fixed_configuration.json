  "w_reg": 1.0,
  "w_bce": 0.6,
  "w_rank": 1.4,
  "grad_clip": 1.0,
  "r_budget": 0.05,
  "checkpoint_threshold": 16,
  "seed": 42,
  "optimizer": "AdamW",
  "checkpoint_metric": "validation_recall_at_budget_r05_tau16",
  "selection_tie_break_rule": "highest validation recall at tau16 under r=0.05; ties keep earliest epoch",
  "training_split_rule": "use corrected_split_assignment.csv H5 locked inner assignments; do not rebuild 15% split independently"
